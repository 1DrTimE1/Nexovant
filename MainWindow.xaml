<Window x:Class="Nexovant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexovant – Säker diskrensning"
        Icon="Assets/Nexovant.ico"
        Width="980" Height="760" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Nexovant.ico" Width="46" Height="46" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nexovant" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="8,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hittar filer som är säkra att ta bort och frigör utrymme på din dator."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" MinWidth="290" VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="DiskFreeText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DiskText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar x:Name="DiskBar" Margin="0,10,0,0" Maximum="100"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Update banner, shown when GitHub has a newer release -->
            <Border x:Name="UpdateBanner" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}"
                    Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,16" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="UpdateBar" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="UpdateButton" Grid.Column="2" Content="Uppdatera nu" Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Click="UpdateButton_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Categories -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <ItemsControl x:Name="CategoryList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,10" Opacity="{Binding CardOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                          ToolTip="Markera eller avmarkera alla filer i kategorin"/>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="#1F2939"
                                        VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,3,0,0" LineHeight="18"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding WarningVisibility}">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Width="200" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeText}" FontSize="20" FontWeight="Bold" TextAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding DetailText}" TextAlignment="Right" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    <Button Content="Välj filer…" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                            Margin="0,4,-8,0" Tag="{Binding}" Visibility="{Binding DetailsVisibility}"
                                            Click="ShowDetails_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    <ProgressBar x:Name="WorkBar" Height="4" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AdminButton" AutomationProperties.Name="Administratör" Style="{StaticResource SecondaryButton}" Click="AdminButton_Click"
                            ToolTip="Behövs för att rensa Windows tillfälliga filer och Windows Update-nedladdningar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Administratör"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanButton" AutomationProperties.Name="Skanna" Style="{StaticResource SecondaryButton}" Click="ScanButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanButtonText" Text="Skanna"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CleanButton" AutomationProperties.Name="Rensa valda" Style="{StaticResource PrimaryButton}" Click="CleanButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CleanButtonText" Text="Rensa valda"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
